# Groq API key — get yours at https://console.groq.com/keys
# La API key la pega David directamente en su .env local. NO commitear.
GROQ_API_KEY=your_groq_api_key_here

# Modelo LLM default. Opciones validas (ago-2026):
#   - openai/gpt-oss-20b (rapido, default — reemplaza llama-3.1-8b-instant
#     deprecado por Groq el 16-ago-2026, ver console.groq.com/docs/deprecations)
#   - openai/gpt-oss-120b (mejor calidad, mas caro — reemplaza
#     llama-3.3-70b-versatile deprecado el 16-ago-2026)
GROQ_MODEL=openai/gpt-oss-20b

# Puerto del servidor Express
PORT=3001

# Cache TTL en segundos (1 hora por default)
CACHE_TTL_SECONDS=3600
