{
  "name": "meta-ads-copy-generator",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered ad copy generator for Meta Ads (Facebook/Instagram). Generates multiple variations of ad copy with different psychological angles, scores them, and exports to Meta Marketing API v20 format.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:fixtures": "ts-node src/scoring/test-fixtures/v1/run-fixtures.ts",
    "test:generate": "bash scripts/test-generate.sh",
    "test:score": "bash scripts/test-score.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "groq-sdk": "^0.7.0",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
